# Rename to turnserver.conf on the persistent host and replace the placeholders
# from its secret manager. This instance should run behind a stable public IP.
listening-port=3478
tls-listening-port=5349
fingerprint
lt-cred-mech
use-auth-secret
static-auth-secret=REPLACE_WITH_LONG_RANDOM_TURN_SECRET
realm=turn.moudie.example
server-name=turn.moudie.example

# Replace with the public interface/address on the deployment host.
listening-ip=0.0.0.0
external-ip=REPLACE_WITH_PUBLIC_IP
min-port=49160
max-port=49260

no-loopback-peers
no-multicast-peers
stale-nonce=600
no-cli
no-tlsv1
no-tlsv1_1
log-file=stdout
simple-log
