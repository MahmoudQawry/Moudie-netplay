# ===== Room service (server) =====
# MySQL connection used by Drizzle (required in production)
DATABASE_URL=mysql://user:password@localhost:3306/classic_era

# Web origins allowed by CORS (comma-separated). Native apps have no Origin
# header and are always allowed. Unset => localhost development is allowed.
# Production example: ALLOWED_ORIGINS=https://classic-era.example.com
ALLOWED_ORIGINS=

# ===== LiveKit room voice (optional) =====
# When unset the built-in WebRTC room voice channel is used instead.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
